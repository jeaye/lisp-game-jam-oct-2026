(ns com.jeaye.claw-game.graphics
  (:include "raylib.h"
            "raylib-trait.hpp"
            "raylib-extension.hpp"
            "box2d/box2d.h"
            "box2d_draw.h"
            "box2d-trait.hpp")
  (:require [com.jeaye.claw-game.physics :as physics]
            [com.jeaye.claw-game.gamepad :as gamepad]))

;https://www.color-hex.com/color-palette/71344
(def color-black (cpp/GetColor 0x0D0221ff))
(def color-gray (cpp/GetColor 0x6B6B8Fff))
(def color-purple (cpp/GetColor 0xb25da6ff))
(def color-pink (cpp/GetColor 0xFF6EC7ff))
(def color-blue (cpp/GetColor 0x6688c3ff))
(def color-green (cpp/GetColor 0x00F5A0ff))
(def color-yellow (cpp/GetColor 0xeaaf41ff))
(def color-red (cpp/GetColor 0xce4a4aff))
(def color-orange (cpp/GetColor 0xFF9E3Dff))

(def text-color cpp/WHITE)

(def background-color color-black)

; TODO: convert phy defs in world space to screen space
(def border-thickness 13)
(def border-padding-x 10)
(def border-padding-y 0)
(def border-color color-purple)

(def bucket-width 120)
(def bucket-height 155)
(def bucket-color background-color)
(def bucket-border-thickness (/ border-thickness 3))
(def bucket-border-color-top color-green)
(def bucket-border-color-right border-color)

(def ticker-height 60)
(def ticker-border-bottom-height (/ border-thickness 3))
(def ticker-border-color border-color)

(def ticker-text-font-size 40)
(def ticker-text-y-offset 18)
(def ticker-text-y (+ border-thickness (/ ticker-height 2) (- ticker-text-y-offset)))
(def ticker-text-color text-color)

(def game-over-border-thickness (/ border-thickness 2))
(def game-over-border-color border-color)

(def game-over-padding 10)

(def game-over-text-font-size 40)
(def game-over-text-color text-color)

(def game-over-restart-text (format "PRESS THE {} BUTTON TO RESTART" (gamepad/get-accept-button-name)))
(def game-over-restart-text-font-size 30)
(def game-over-restart-text-width (cpp/MeasureText game-over-restart-text game-over-restart-text-font-size))

(def claw-hub-color color-gray)
(def claw-arm-color color-pink)
(def piece-box-color color-orange)
(def piece-triangle-color color-green)
(def piece-circle-color color-red)
(def piece-rectangle-color color-yellow)
(def piece-capsule-color color-blue)

(def claw-arm-thickness 6.0)
(def piece-line-thickness 2.0)

(defn world-to-screen-position [world-pos]
  (let [orig-x (/ (cpp/GetScreenWidth) 2.0)
        orig-y (/ (cpp/GetScreenHeight) 2.0)
        ppm (/ orig-x (/ (* physics/world-width physics/world-to-screen-modifier) 2.0))]
    {:x (+ orig-x (* (:x world-pos) ppm))
     :y (- orig-y (* (:y world-pos) ppm))}))

(defn world-to-screen-size [world-size]
  (let [screen-width (cpp/GetScreenWidth)
        world-percent (/ world-size (* physics/world-width physics/world-to-screen-modifier))]
    (* world-percent screen-width)))

(defn render-debug-world! [state]
  (let [debug (cpp/b2CreateDebugDraw (/ (cpp/GetScreenWidth)
                                        (* physics/world-width physics/world-to-screen-modifier)))
        world-id (cpp/* (cpp/unbox (:* b2WorldId) (get-in state [:physics :world-id])))]
    (cpp/b2World_Draw world-id (cpp/& debug))))

(defn render-capsule! [^(:* b2BodyId) body-id screen-pos degrees center-a center-b radius width]
  (let [body-id (cpp/* body-id)
        circle-a-world-pos (cpp/b2Body_GetWorldPoint body-id center-a)
        circle-a-screen-pos (world-to-screen-position circle-a-world-pos)
        circle-b-world-pos (cpp/b2Body_GetWorldPoint body-id center-b)
        circle-b-screen-pos (world-to-screen-position circle-b-world-pos)
        radius (world-to-screen-size radius)
        width (world-to-screen-size width)
        height (* radius 2)]
    (cpp/DrawCircleLinesEx (cpp/Vector2 (int (:x circle-a-screen-pos))
                                        (int (:y circle-a-screen-pos)))
                           radius
                           piece-line-thickness
                           piece-capsule-color)
    (cpp/DrawRectangleProLinesEx (cpp/Rectangle (:x screen-pos)
                                                (:y screen-pos)
                                                width
                                                height)
                                 (cpp/Vector2 (/ width 2.0) (/ height 2.0))
                                 (- degrees 45.0)
                                 piece-line-thickness
                                 piece-capsule-color)
    (cpp/DrawCircleLinesEx (cpp/Vector2 (int (:x circle-b-screen-pos))
                                        (int (:y circle-b-screen-pos)))
                           radius
                           piece-line-thickness
                           piece-capsule-color)))

(defn render-claw-arm! [state side]
  (let [body-id (cpp/* (cpp/unbox (:* b2BodyId) (get-in state [:physics (if (= :left side)
                                                                          :left-tip-id
                                                                          :right-tip-id)])))
        world-pos (cpp/b2Body_GetPosition body-id)
        screen-pos (world-to-screen-position world-pos)]
    (dotimes [i 3]
      (let [start-local (nth (get physics/claw-tip-points side) i)
            start-world (cpp/b2Body_GetWorldPoint body-id start-local)
            start-screen (world-to-screen-position start-world)
            end-local (nth (get physics/claw-tip-points side) (inc i))
            end-world (cpp/b2Body_GetWorldPoint body-id end-local)
            end-screen (world-to-screen-position end-world)]
        (cpp/DrawLineEx (cpp/Vector2 (:x start-screen)
                                     (:y start-screen))
                        (cpp/Vector2 (:x end-screen)
                                     (:y end-screen))
                        claw-arm-thickness
                        claw-arm-color)))))

(defn render-claw! [state]
  ; Central hub.
  (let [body-id (cpp/* (cpp/unbox (:* b2BodyId) (get-in state [:physics :central-hub-id])))
        world-pos (cpp/b2Body_GetPosition body-id)
        screen-pos (world-to-screen-position world-pos)
        rot (cpp/b2Body_GetRotation body-id)
        degrees (- (physics/radians-to-degrees (cpp/b2Rot_GetAngle rot)))
        width (world-to-screen-size physics/claw-hub-width)
        height (world-to-screen-size physics/claw-hub-height)]
    (cpp/DrawRectanglePro (cpp/Rectangle (:x screen-pos)
                                         (:y screen-pos)
                                         width
                                         height)
                          (cpp/Vector2 (/ width 2.0) (/ height 2.0))
                          degrees
                          claw-hub-color))

  (render-claw-arm! state :left)
  (render-claw-arm! state :right))

(defn render-world! [state]
  ;(render-debug-world! state)
  (render-claw! state)
  (doseq [[body-id-boxed piece] (get-in state [:physics :pieces])]
    (let [body-id (cpp/* (cpp/unbox (:* b2BodyId) body-id-boxed))]
      ; TODO: Probaly not needed anymore?
      (when (cpp/b2Body_IsValid body-id)
        (let [world-pos (cpp/b2Body_GetPosition body-id)
              screen-pos (world-to-screen-position world-pos)
              rot (cpp/b2Body_GetRotation body-id)
              degrees (- (physics/radians-to-degrees (cpp/b2Rot_GetAngle rot)))]
          (case (:type piece)
            :triangle
            (let [size (:size-multiplier piece)
                  point-0-world-pos (cpp/b2Body_GetWorldPoint body-id (cpp/b2Vec2 0.0 (* 0.115470 size)))
                  point-0-screen-pos (world-to-screen-position point-0-world-pos)
                  point-1-world-pos (cpp/b2Body_GetWorldPoint body-id (cpp/b2Vec2 (* -0.1 size) (* -0.057735 size)))
                  point-1-screen-pos (world-to-screen-position point-1-world-pos)
                  point-2-world-pos (cpp/b2Body_GetWorldPoint body-id (cpp/b2Vec2 (* 0.1 size) (* -0.057735 size)))
                  point-2-screen-pos (world-to-screen-position point-2-world-pos)]
              (cpp/DrawTriangleLinesEx (cpp/Vector2 (:x point-0-screen-pos) (:y point-0-screen-pos))
                                       (cpp/Vector2 (:x point-1-screen-pos) (:y point-1-screen-pos))
                                       (cpp/Vector2 (:x point-2-screen-pos) (:y point-2-screen-pos))
                                       piece-line-thickness
                                       piece-triangle-color))

            :box
            (let [size (world-to-screen-size (* (* physics/base-box-size 2)
                                                (:size-multiplier piece)))]
              (cpp/DrawRectangleProLinesEx (cpp/Rectangle (:x screen-pos)
                                                          (:y screen-pos)
                                                          size
                                                          size)
                                           (cpp/Vector2 (/ size 2.0) (/ size 2.0))
                                           degrees
                                           piece-line-thickness
                                           piece-box-color))


            (:circle :token)
            (let [radius (world-to-screen-size (* physics/base-circle-size
                                                  (:size-multiplier piece)))]
              (cpp/DrawCircleLinesEx (cpp/Vector2 (int (:x screen-pos))
                                                  (int (:y screen-pos)))
                                     radius
                                     piece-line-thickness
                                     piece-circle-color))

            :rectangle
            (let [width (world-to-screen-size (* (* physics/base-rectangle-width 2)
                                                 (:size-multiplier piece)))
                  height (world-to-screen-size (* (* physics/base-rectangle-height 2)
                                                  (:size-multiplier piece)))]
              (cpp/DrawRectangleProLinesEx (cpp/Rectangle (:x screen-pos)
                                                          (:y screen-pos)
                                                          width
                                                          height)
                                           (cpp/Vector2 (/ width 2.0) (/ height 2.0))
                                           degrees
                                           piece-line-thickness
                                           piece-rectangle-color))

            :capsule
            (render-capsule! body-id-boxed
                             screen-pos
                             degrees
                             {:x -0.1
                              :y -0.1}
                             {:x 0.1
                              :y 0.1}
                             (* physics/base-capsule-size (:size-multiplier piece))
                             0.2)))))))

(defn ceil [x]
  (let [n (long x)]
    (if (> x n) (inc n) n)))

(defn paused? [state]
  (contains? #{:paused :game-over}
             (:mode state)))

(defn render-ui! [state]
  (let [screen-width (cpp/GetScreenWidth)
        screen-height (cpp/GetScreenHeight)]

    ; Playspace bucket: background, top border, right border.
    (cpp/DrawRectangle (+ border-padding-x border-thickness)
                       (- screen-height border-thickness bucket-height)
                       bucket-width
                       bucket-height
                       bucket-color)
    (cpp/DrawRectangle (+ border-padding-x border-thickness bucket-width (- bucket-border-thickness))
                       (- screen-height border-thickness bucket-height)
                       bucket-border-thickness
                       bucket-height
                       bucket-border-color-right)
    (cpp/DrawRectangle (+ border-padding-x border-thickness)
                       (- screen-height border-thickness bucket-height)
                       bucket-width
                       bucket-border-thickness
                       bucket-border-color-top)

    ; Playspace borders: right, left, top, bottom.
    (cpp/DrawRectangle border-padding-x
                       border-padding-y
                       border-thickness
                       screen-height
                       border-color)
    (cpp/DrawRectangle (- screen-width border-padding-x border-thickness)
                       border-padding-y
                       border-thickness
                       screen-height
                       border-color)
    (cpp/DrawRectangle border-padding-x
                       border-padding-y
                       (- screen-width (* border-padding-x 2))
                       border-thickness
                       border-color)
    (cpp/DrawRectangle border-padding-x
                       (- screen-height border-padding-y border-thickness)
                       (- screen-width (* border-padding-x 2))
                       border-thickness
                       border-color)

    ; Playspace ticker: background, bottom border.
    (cpp/DrawRectangle (+ border-padding-x border-thickness)
                       border-thickness
                       (- screen-width (* border-thickness 2) (* border-padding-x 2))
                       ticker-height
                       background-color)
    (cpp/DrawRectangle (+ border-padding-x border-thickness)
                       (+ border-thickness ticker-height)
                       (- screen-width (* border-thickness 2) (* border-padding-x 2))
                       ticker-border-bottom-height
                       ticker-border-color)

    ; Playspace ticker text.
    ; TODO: consider subtitle (eg. controls, press x to restart, etc.)
    (when-some [ticker-text (cond
                              (= :coin-drop (:mode state)) "INSERT A COIN TO PLAY"
                              (= :countdown (:mode state)) (str (ceil (:countdown-time-remaining state)))
                              (= :playing (:mode state)) (format "TIME: {} --- SCORE: {}"
                                                                (ceil (:time-remaining state))
                                                                (ceil (:score state)))
                              (= :game-over (:mode state)) "GAME OVER"
                              (paused? state) "PAUSED"
                              nil)]
      (let [ticker-text-width (cpp/MeasureText ticker-text ticker-text-font-size)
            ticker-text-x (- (/ screen-width 2) (/ ticker-text-width 2))]
        (cpp/DrawText ticker-text
                      ticker-text-x
                      ticker-text-y
                      ticker-text-font-size
                      ticker-text-color)))

    (when (= :game-over (:mode state))
      (let [; TODO: add complete game over stats
            game-over-text (format "SCORE: {}" (:score state))

            game-over-width (int (* screen-width 0.8))
            game-over-height (int (* screen-height 0.7))

            game-over-x (- (/ screen-width 2)
                           (/ game-over-width 2)
                           game-over-border-thickness)
            game-over-y (- (/ (+ screen-height border-thickness ticker-height) 2)
                           (/ game-over-height 2)
                           game-over-border-thickness)]

        ; Game over modal + border.
        (cpp/DrawRectangle (- game-over-x game-over-border-thickness)
                           (- game-over-y game-over-border-thickness)
                           (+ game-over-width (* game-over-border-thickness 2))
                           (+ game-over-height (* game-over-border-thickness 2))
                           game-over-border-color)
        (cpp/DrawRectangle game-over-x
                           game-over-y
                           game-over-width
                           game-over-height
                           background-color)

        ; Game over stats.
        (cpp/DrawText game-over-text
                      (+ game-over-x game-over-padding)
                      (+ game-over-y game-over-padding)
                      game-over-text-font-size
                      game-over-text-color)

        ; Game over restart text.
        (cpp/DrawText game-over-restart-text
                      (+ game-over-x game-over-padding
                         (- (/ game-over-restart-text-width 2)))
                      (+ game-over-y game-over-height
                         (- (int (* game-over-restart-text-font-size 0.8)))
                         (- game-over-padding))
                      game-over-restart-text-font-size
                      game-over-text-color)))

    nil))

(defn render! [state]
  (render-world! state)
  (render-ui! state)
  nil)
