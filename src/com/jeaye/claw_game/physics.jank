(ns com.jeaye.claw-game.physics
  (:include "box2d/box2d.h"
            "raylib.h"
            "box2d-trait.hpp")
  (:require [com.jeaye.claw-game.bucket :as bucket]
            [com.jeaye.claw-game.gamepad :as gamepad]))

(cpp/raw "bool b2BodyIdEquals(b2BodyId const a, b2BodyId const b){ return B2_ID_EQUALS(a, b); }")

(defn degrees-to-radians [deg]
  (* deg (/ 3.14159 180.0)))

(defn radians-to-degrees [rad]
  (* rad (/ 180.0 3.14159)))

(defn clamp [n min max]
  (if (< n min)
    min
    (if (< max n)
      max
      n)))

; Types of pieces that can be randomly spawned.
(def random-piece-types [:triangle :box :circle :rectangle :capsule])

; The game world is 4 meters wide and 6 meters tall, to accomodate for box2d's
; physics which work well with moving objects from 0.1 meters to 10 meters.
; https://box2d.org/documentation/index.html#autotoc_md6
(def world-width 16.0)
(def world-height 9.0)
(def world-gravity -3.0)
(def world-to-screen-modifier 1.05)

(def wall-width 0.2)

(def bucket-width (clamp (* world-width 0.3) 0.2 2))
(def bucket-sensor-height 0.1)
(def bucket-wall-height (* world-height 0.3))
(def bucket-wall-width 0.1)

; How open/closed can the claw tips get?
(def claw-tip-max-open-angle (degrees-to-radians 90.0))
(def claw-tip-max-close-angle (degrees-to-radians -90.0))
; How snappy is the claw tip open/close, following the left/right triggers?
(def claw-tip-track-gain 12.0)
(def claw-tip-max-speed 5.0)
(def claw-tip-density 1.0)
(def claw-tip-friction 0.8)

; How much can the claw rotate, in either direction, using the right stick?
(def claw-max-rotation-angle (degrees-to-radians 45.0))
; How snappy is the claw rotation, following the right stick?
(def claw-carriage-track-gain 3.0)
(def claw-carriage-rotation-max-speed 3.0)
; How fast does the claw move, using the left stick?
(def claw-carriage-max-speed 2.5)
(def claw-carriage-density 5.0)
(def claw-carriage-friction 0.3)

(def claw-hub-width 0.6)
(def claw-hub-height 0.2)

; Number of pieces of each shape to create.
(def box-create-count 200)
(def triangle-create-count 200)
(def circle-create-count 200)
(def capsule-create-count 100)
(def rectangle-create-count 30)
(def token-size 5)
(def piece-max-size 2)
(def bonus-piece-count 10)
; Percent chance to spawn a new piece when scoring. (0.4 == 40%)
(def chance-to-spawn-piece-on-score 0.4)

(def base-box-size 0.1)
(def base-circle-size 0.1)
(def base-capsule-size 0.05)
(def base-rectangle-width 0.2)
(def base-rectangle-height 0.1)

(def piece-density 0.3)
(def piece-friction 0.4)

; This controls the number of sub-steps that box2d does per tick.
; More sub-steps will result in more precision.
(def sub-step-count 8)

(def filters {:piece 2r000000001
              :wall 2r000000010
              :claw-carriage 2r000000100
              :claw-tip 2r000001000})

; -----------------------------------------------------------------------------
; Creation

(defn create-playspace! [^(:* b2WorldId) world-id]
  (let [bucket-body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-position bucket-body-def) (cpp/b2Vec2 (+ (/ world-width -2.0)
                                                             (/ bucket-width 2.0))
                                                          (+ (/ world-height -2.0)
                                                             (/ bucket-sensor-height 2.0))))
        bucket-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& bucket-body-def))

        bucket-box (cpp/b2MakeBox (/ bucket-width 2.0)
                                  (/ bucket-sensor-height 2.0))
        bucket-shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/= (.-isSensor bucket-shape-def) true)
        _ (cpp/= (.-enableSensorEvents bucket-shape-def) true)
        _ (cpp/b2CreatePolygonShape bucket-id (cpp/& bucket-shape-def) (cpp/& bucket-box))

        bucket-wall-body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-position bucket-wall-body-def) (cpp/b2Vec2 (+ (/ world-width -2)
                                                                  bucket-width
                                                                  (/ bucket-wall-width 2))
                                                               (+ (/ world-height -2)
                                                                  (/ bucket-wall-height 2))))
        bucket-wall-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& bucket-wall-body-def))

        bucket-wall-box (cpp/b2MakeBox (/ bucket-wall-width 2.0) (/ bucket-wall-height 2.0))
        bucket-wall-shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/b2CreatePolygonShape bucket-wall-id (cpp/& bucket-wall-shape-def) (cpp/& bucket-wall-box))

        left-wall-body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-position left-wall-body-def) (cpp/b2Vec2 (- (/ world-width -2)
                                                                (/ wall-width 2))
                                                             0.0))
        left-wall-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& left-wall-body-def))

        left-wall-box (cpp/b2MakeBox (/ wall-width 2.0) (/ world-height 2.0))
        left-wall-shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/b2CreatePolygonShape left-wall-id (cpp/& left-wall-shape-def) (cpp/& left-wall-box))

        right-wall-body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-position right-wall-body-def) (cpp/b2Vec2 (+ (/ world-width 2)
                                                                 (/ wall-width 2))
                                                              0.0))
        right-wall-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& right-wall-body-def))

        right-wall-box (cpp/b2MakeBox (/ wall-width 2.0) (/ world-height 2.0))
        right-wall-shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/b2CreatePolygonShape right-wall-id (cpp/& right-wall-shape-def) (cpp/& right-wall-box))

        top-wall-body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-position top-wall-body-def) (cpp/b2Vec2 0.0
                                                               (+ (/ world-height 2)
                                                                  (/ wall-width 2))))
        top-wall-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& top-wall-body-def))

        top-wall-box (cpp/b2MakeBox (+ (/ world-width 2.0) wall-width) (/ wall-width 2.0))
        top-wall-shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/b2CreatePolygonShape top-wall-id (cpp/& top-wall-shape-def) (cpp/& top-wall-box))

        bottom-wall-body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-position bottom-wall-body-def) (cpp/b2Vec2 0.0
                                                               (- (/ world-height -2)
                                                                  (/ wall-width 2))))
        bottom-wall-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& bottom-wall-body-def))

        bottom-wall-box (cpp/b2MakeBox (+ (/ world-width 2.0) wall-width) (/ wall-width 2.0))
        bottom-wall-shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/b2CreatePolygonShape bottom-wall-id (cpp/& bottom-wall-shape-def) (cpp/& bottom-wall-box))]
    ))

(defn random-piece-size! []
  (+ 1.0 (rand (- piece-max-size 1))))

(defn rand-pos []
  {:x (rand (/ world-width 2))
   :y (rand (/ world-height -2))})

(defn create-box-piece! [^(:* b2WorldId) world-id
                         ^(:* b2ShapeDef) shape-def
                         pos]
  (let [body-def (cpp/b2DefaultBodyDef)
        size (random-piece-size!)
        box (cpp/b2MakeBox (* base-box-size size) (* base-box-size size))
        _ (cpp/= (.-type body-def) cpp/b2_dynamicBody)
        _ (cpp/= (.-position body-def) (cpp/cast b2Vec2 pos))
        body-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& body-def))
        _ (cpp/b2CreatePolygonShape body-id shape-def (cpp/& box))]
    {:type :box
     :size-multiplier size
     :body-id (cpp/box (cpp/new b2BodyId body-id))}))

(defn create-triangle-piece! [^(:* b2WorldId) world-id
                              ^(:* b2ShapeDef) shape-def
                              pos]
  (let [triangle-points (#cpp (:array b2Vec2 3))
        size (random-piece-size!)
        ; TODO: We shouldn't do this for every triangle we create.
        ; Do it once and then put it into a var or something.
        _ (do
            (cpp/= (cpp/aget triangle-points 0) (cpp/b2Vec2 0.0 (* 0.115470 size)))
            (cpp/= (cpp/aget triangle-points 1) (cpp/b2Vec2 (* -0.1 size) (* -0.057735 size)))
            (cpp/= (cpp/aget triangle-points 2) (cpp/b2Vec2 (* 0.1 size) (* -0.057735 size))))
        triangle-hull (cpp/b2ComputeHull triangle-points 3)
        triangle (cpp/b2MakePolygon (cpp/& triangle-hull) 0.0)
        body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-type body-def) cpp/b2_dynamicBody)
        _ (cpp/= (.-position body-def) (cpp/cast b2Vec2 pos))
        body-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& body-def))
        _ (cpp/b2CreatePolygonShape body-id shape-def (cpp/& triangle))]
    {:type :triangle
     :size-multiplier size
     :body-id (cpp/box (cpp/new b2BodyId body-id))}))

(defn create-circle-piece! [^(:* b2WorldId) world-id
                            ^(:* b2ShapeDef) shape-def
                            pos]
  (let [size (random-piece-size!)
        circle (cpp/b2Circle (cpp/b2Vec2 0.0 0.0) (* base-circle-size size))
        body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-type body-def) cpp/b2_dynamicBody)
        _ (cpp/= (.-position body-def) (cpp/b2Vec2 (rand (/ world-width 2))
                                                   (rand (/ world-height -2))))
        body-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& body-def))
        _ (cpp/b2CreateCircleShape body-id shape-def (cpp/& circle))]
    {:type :circle
     :size-multiplier size
     :body-id (cpp/box (cpp/new b2BodyId body-id))}))

(defn create-token-piece! [^(:* b2WorldId) world-id
                           ^(:* b2ShapeDef) shape-def
                           pos]
  (let [size token-size
        circle (cpp/b2Circle (cpp/b2Vec2 0.0 0.0) (* base-circle-size size))
        body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-type body-def) cpp/b2_dynamicBody)
        _ (cpp/= (.-position body-def) (cpp/b2Vec2 (rand (/ world-width 2))
                                                   (rand (/ world-height -2))))
        body-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& body-def))
        _ (cpp/b2CreateCircleShape body-id shape-def (cpp/& circle))]
    {:type :token
     :size-multiplier size
     :body-id (cpp/box (cpp/new b2BodyId body-id))}))

(defn create-capsule-piece! [^(:* b2WorldId) world-id
                             ^(:* b2ShapeDef) shape-def
                             pos]
  (let [size (random-piece-size!)
        capsule (cpp/b2Capsule (cpp/b2Vec2 -0.1 -0.1)
                               (cpp/b2Vec2  0.1  0.1)
                               (* base-capsule-size size))
        body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-type body-def) cpp/b2_dynamicBody)
        _ (cpp/= (.-position body-def) (cpp/cast b2Vec2 pos))
        body-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& body-def))
        _ (cpp/b2CreateCapsuleShape body-id shape-def (cpp/& capsule))]
    {:type :capsule
     :size-multiplier size
     :body-id (cpp/box (cpp/new b2BodyId body-id))}))

(defn create-rectangle-piece! [^(:* b2WorldId) world-id
                               ^(:* b2ShapeDef) shape-def
                               pos]
  ; TODO: rectangles can spawn intersectting the walls
  (let [size (random-piece-size!)
        rectangle (cpp/b2MakeBox (* base-rectangle-width size) base-rectangle-height)
        body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-type body-def) cpp/b2_dynamicBody)
        _ (cpp/= (.-position body-def) (cpp/cast b2Vec2 pos))
        body-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& body-def))
        _ (cpp/b2CreatePolygonShape body-id shape-def (cpp/& rectangle))]
    {:type :rectangle
     :size-multiplier size
     :body-id (cpp/box (cpp/new b2BodyId body-id))}))

; TODO: make shape definitions more configurable
; TODO: More shapes? Star?
; TODO: reduce duplication with body creation
(defn create-pieces! [world-id]
  (let [shape-def (cpp/b2DefaultShapeDef)
        ; TODO: Mass.
        _ (cpp/= (.-enableSensorEvents shape-def) true)
        _ (cpp/= (.-density shape-def) piece-density)
        _ (cpp/= (.-friction (.-material shape-def)) piece-friction)
        _ (cpp/= (.-categoryBits (.-filter shape-def)) (int (:piece filters)))
        shape-def-boxed (cpp/box (cpp/new b2ShapeDef shape-def))
        pieces (volatile! [])]

    ; spawn boxes
    (dotimes [_ box-create-count]
      (->> (create-box-piece! world-id shape-def-boxed (rand-pos))
           (vswap! pieces conj)))

    ; spawn triangles
    (dotimes [_ triangle-create-count]
      (->> (create-triangle-piece! world-id shape-def-boxed (rand-pos))
           (vswap! pieces conj)))

    ; spawn circles
    (dotimes [_ circle-create-count]
      (->> (create-circle-piece! world-id shape-def-boxed (rand-pos))
           (vswap! pieces conj)))

    ; spawn capsules
    (dotimes [_ capsule-create-count]
      (->> (create-capsule-piece! world-id shape-def-boxed (rand-pos))
           (vswap! pieces conj)))

    ; spawn rectangles
    (dotimes [_ capsule-create-count]
      (->> (create-rectangle-piece! world-id shape-def-boxed (rand-pos))
           (vswap! pieces conj)))

    ; select random pieces to be marked as bonus
    ; TODO: prevent selecting the same piece multiple
    (dotimes [_ bonus-piece-count]
      (let [idx (rand-int (count @pieces))]
        (vswap! pieces assoc-in [idx :bonus?] true)))

    @pieces))

(defn spawn-random-piece! [world-id]
  ; TODO: Reuse this shape-def with create-pieces!
  (let [shape-def (cpp/b2DefaultShapeDef)
        ; TODO: Mass.
        _ (cpp/= (.-enableSensorEvents shape-def) true)
        _ (cpp/= (.-density shape-def) piece-density)
        _ (cpp/= (.-friction (.-material shape-def)) piece-friction)
        _ (cpp/= (.-categoryBits (.-filter shape-def)) (int (:piece filters)))
        shape-def-boxed (cpp/box (cpp/new b2ShapeDef shape-def))
        pos {:x (+ (- (rand (- world-width bucket-width))
                      (/ world-width 2.0))
                   bucket-width)
             :y (/ world-height 2.0)}]
    (case (rand-nth random-piece-types)
      :triangle (create-triangle-piece! world-id shape-def-boxed pos)
      :box (create-box-piece! world-id shape-def-boxed pos)
      :circle (create-circle-piece! world-id shape-def-boxed pos)
      :rectangle (create-rectangle-piece! world-id shape-def-boxed pos)
      :capsule (create-capsule-piece! world-id shape-def-boxed pos))))

(def claw-tip-points (let [third-length 0.3
                           half-third-length (/ third-length 2)
                           deg-30 (- (- third-length) (* third-length (cpp/cos (degrees-to-radians 30))))
                           deg-60 (degrees-to-radians 60)
                           left [{:x 0.0 :y 0.0}
                                 {:x 0.0 :y (- third-length)}
                                 {:x half-third-length :y deg-30}
                                 {:x (+ half-third-length (* third-length (cpp/sin deg-60)))
                                  :y (- deg-30 (* third-length (cpp/cos deg-60)))}]]
                       {:left left
                        :right (mapv (fn [{:keys [x y]}]
                                       {:x (- x)
                                        :y y})
                                     left)}))

(defn create-claw-tip! [^(:* b2WorldId) world-id ^b2Vec2 pos side]
  (let [body-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-position body-def) pos)
        _ (cpp/= (.-angularDamping body-def) 1.0)
        _ (cpp/= (.-isBullet body-def) true)
        _ (cpp/= (.-enableSleep body-def) false)
        _ (cpp/= (.-type body-def) cpp/b2_dynamicBody)
        body-id (cpp/b2CreateBody (cpp/* world-id) (cpp/& body-def))
        shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/= (.-density shape-def) claw-tip-density)
        _ (cpp/= (.-friction (.-material shape-def)) claw-tip-friction)
        _ (cpp/= (.-restitution (.-material shape-def)) 0.0)
        _ (cpp/= (.-categoryBits (.-filter shape-def)) (int (:claw-tip filters)))
        _ (cpp/= (.-maskBits (.-filter shape-def)) (:piece filters))
        tip-radius 0.05]
    (dotimes [i 3]
      (let [capsule (cpp/b2Capsule (nth (get claw-tip-points side) i)
                                   (nth (get claw-tip-points side) (inc i))
                                   tip-radius)]
        (cpp/b2CreateCapsuleShape body-id (cpp/& shape-def) (cpp/& capsule))))
    (cpp/box (cpp/new b2BodyId body-id))))

(defn create-claw-tip-joint! [^(:* b2WorldId) world-id
                              ^(:* b2BodyId) hub-id
                              ^(:* b2BodyId) tip-id
                              lower
                              upper
                              direction]
  (let [joint-def (cpp/b2DefaultRevoluteJointDef)
        _ (do
            (cpp/= (.-bodyIdA (.-base joint-def)) (cpp/* hub-id))
            (cpp/= (.-bodyIdB (.-base joint-def)) (cpp/* tip-id))
            (cpp/= (.-p (.-localFrameA (.-base joint-def))) (cpp/b2Vec2 (if (= :left direction)
                                                                          -0.3
                                                                          0.3)
                                                                        0.0))
            (cpp/= (.-p (.-localFrameB (.-base joint-def))) (cpp/b2Vec2 0.0 0.0))
            (cpp/= (.-collideConnected (.-base joint-def)) false)

            (cpp/= (.-enableLimit joint-def) true)
            (cpp/= (.-lowerAngle joint-def) lower)
            (cpp/= (.-upperAngle joint-def) upper)

            (cpp/= (.-enableMotor joint-def) true)
            (cpp/= (.-maxMotorTorque joint-def) 3.0)
            (cpp/= (.-motorSpeed joint-def) 0.0)

            (cpp/= (.-enableSpring joint-def) false))
        joint-id (cpp/b2CreateRevoluteJoint (cpp/* world-id) (cpp/& joint-def))]
    (cpp/box (cpp/new b2JointId joint-id))))

(defn create-claw-carriage-distance-joint! [^(:* b2WorldId) world-id
                                   ^(:* b2BodyId) central-hub-id
                                   ^(:* b2BodyId) hub-id]
  (let [joint-def (cpp/b2DefaultDistanceJointDef)
        _ (do
            (cpp/= (.-bodyIdA (.-base joint-def)) (cpp/* central-hub-id))
            (cpp/= (.-bodyIdB (.-base joint-def)) (cpp/* hub-id)))
        joint-id (cpp/b2CreateDistanceJoint (cpp/* world-id) (cpp/& joint-def))]
    (cpp/box (cpp/new b2JointId joint-id))))

(defn create-claw-carriage-revolute-joint! [^(:* b2WorldId) world-id
                                            ^(:* b2BodyId) carriage-id
                                            ^(:* b2BodyId) hub-id]
  (let [joint-def (cpp/b2DefaultRevoluteJointDef)
        _ (do
            (cpp/= (.-bodyIdA (.-base joint-def)) (cpp/* carriage-id))
            (cpp/= (.-bodyIdB (.-base joint-def)) (cpp/* hub-id))
            (cpp/= (.-p (.-localFrameA (.-base joint-def))) (cpp/b2Vec2 0.0 -0.5))
            (cpp/= (.-p (.-localFrameB (.-base joint-def))) (cpp/b2Vec2 0.0 0.0))
            (cpp/= (.-collideConnected (.-base joint-def)) false)

            (cpp/= (.-enableLimit joint-def) true)
            (cpp/= (.-lowerAngle joint-def) (degrees-to-radians -45.0))
            (cpp/= (.-upperAngle joint-def) (degrees-to-radians 45.0))

            (cpp/= (.-enableMotor joint-def) true)
            (cpp/= (.-maxMotorTorque joint-def) 3.0)
            (cpp/= (.-motorSpeed joint-def) 0.0)

            (cpp/= (.-enableSpring joint-def) false))
        joint-id (cpp/b2CreateRevoluteJoint (cpp/* world-id) (cpp/& joint-def))]
    (cpp/box (cpp/new b2JointId joint-id))))

(defn create-claw-carriage! [world-id]
  (let [world-id* (cpp/unbox (:* b2WorldId) world-id)

        carriage-pos {:x 0.0 :y (- (/ world-height 2) 1)}
        carriage-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-type carriage-def) cpp/b2_kinematicBody)
        _ (cpp/= (.-position carriage-def) (cpp/cast b2Vec2 carriage-pos))
        carriage-id (cpp/b2CreateBody (cpp/* world-id*) (cpp/& carriage-def))
        carriage-id-boxed (cpp/box (cpp/new b2BodyId carriage-id))
        carriage-shape-def (cpp/b2DefaultShapeDef)
        ; TODO: Disable collision with pieces on the carriage box. It won't be rendered.
        _ (cpp/= (.-categoryBits (.-filter carriage-shape-def)) (int (:claw-carriage filters)))
        carriage-box (cpp/b2MakeBox 0.1 0.1)
        _ (cpp/b2CreatePolygonShape carriage-id (cpp/& carriage-shape-def) (cpp/& carriage-box))

        central-hub-pos {:x 0.0 :y (- (/ world-height 2) 0.5)}
        central-hub-def (cpp/b2DefaultBodyDef)
        _ (cpp/= (.-type central-hub-def) cpp/b2_dynamicBody)
        _ (cpp/= (.-position central-hub-def) (cpp/cast b2Vec2 central-hub-pos))
        central-hub-id (cpp/b2CreateBody (cpp/* world-id*) (cpp/& central-hub-def))
        central-hub-id-boxed (cpp/box (cpp/new b2BodyId central-hub-id))
        central-hub-shape-def (cpp/b2DefaultShapeDef)
        _ (cpp/= (.-density central-hub-shape-def) claw-carriage-density)
        _ (cpp/= (.-friction (.-material central-hub-shape-def)) claw-carriage-friction)
        _ (cpp/= (.-categoryBits (.-filter central-hub-shape-def)) (int (:claw-carriage filters)))
        central-hub-box (cpp/b2MakeBox (/ claw-hub-width 2.0) (/ claw-hub-height 2.0))
        _ (cpp/b2CreatePolygonShape central-hub-id (cpp/& central-hub-shape-def) (cpp/& central-hub-box))

        central-hub-joint-id (create-claw-carriage-revolute-joint! world-id carriage-id-boxed central-hub-id-boxed)
        ]
    {:carriage-id carriage-id-boxed
     :central-hub-id central-hub-id-boxed
     :central-hub-joint-id central-hub-joint-id}))

(defn create-claw! [world-id]
  (let [{:keys [carriage-id
                central-hub-id
                central-hub-joint-id]} (create-claw-carriage! world-id)

        left-tip (create-claw-tip! world-id {:x -0.3 :y 0.5} :left)
        right-tip (create-claw-tip! world-id {:x 0.3 :y 0.5} :right)

        left-joint (create-claw-tip-joint! world-id
                                           central-hub-id left-tip
                                           claw-tip-max-close-angle
                                           claw-tip-max-open-angle
                                           :left)
        right-joint (create-claw-tip-joint! world-id
                                            central-hub-id right-tip
                                            claw-tip-max-close-angle
                                            claw-tip-max-open-angle
                                            :right)
        ]
    {:carriage-id carriage-id
     :central-hub-id central-hub-id
     :central-hub-joint-id central-hub-joint-id
     :left-tip-id left-tip
     :left-joint-id left-joint
     :right-tip-id right-tip
     :right-joint-id right-joint}))

(defn create-token! [world-id]
  (let [shape-def (cpp/b2DefaultShapeDef)
        ; TODO: Mass.
        _ (cpp/= (.-enableSensorEvents shape-def) true)
        _ (cpp/= (.-density shape-def) piece-density)
        _ (cpp/= (.-friction (.-material shape-def)) piece-friction)
        _ (cpp/= (.-categoryBits (.-filter shape-def)) (int (:piece filters)))
        shape-def-boxed (cpp/box (cpp/new b2ShapeDef shape-def))]
    (create-token-piece! world-id shape-def-boxed (rand-pos))))

(defn create-world! []
  (let [world-def (cpp/b2DefaultWorldDef)
        _ (cpp/= (.-gravity world-def) (cpp/b2Vec2 0.0 world-gravity))
        world-id (cpp/b2CreateWorld (cpp/& world-def))
        world-id-box (cpp/box (cpp/new b2WorldId world-id))
        _ (create-playspace! world-id-box)
        pieces [(create-token! world-id-box)]]
    (assoc (create-claw! world-id-box)
           :pieces (zipmap (map :body-id pieces) pieces)
           :world-id world-id-box)))

(defn destroy-world! [id]
  (when id
    (cpp/b2DestroyWorld (cpp/* (cpp/unbox (:* b2WorldId) id)))))

; -----------------------------------------------------------------------------
; Updating

; raylib gives us a gamepad axis of -1.0 (fully released) to 1.0 (fully pressed).
; We want to normalize that to a range of 0.0 and 1.0.
(defn normalize-claw-tip-axis [axis]
  (let [t (* (+ axis 1.0) 0.5)]
    (cond
      (< t gamepad/deadzone)
      0.0
      (< (- 1.0 gamepad/deadzone) t)
      1.0
      :else
      t)))

(defn lerp [n min max]
  (+ min (* n (abs (- min max)))))

(defn drive-claw-tip! [^(:* b2JointId) joint-id side axis]
  (let [target (if (= :left side)
                 (lerp axis claw-tip-max-close-angle 0.0)
                 (- claw-tip-max-open-angle (lerp axis 0.0 claw-tip-max-open-angle)))
        current (cpp/b2RevoluteJoint_GetAngle (cpp/* joint-id))
        speed (clamp (* claw-tip-track-gain (- target current))
                     (- claw-tip-max-speed)
                     claw-tip-max-speed)]
    (cpp/b2RevoluteJoint_SetMotorSpeed (cpp/* joint-id) speed)))

(defn drive-claw-rotation! [^(:* b2JointId) joint-id axis]
  (let [target (if (< axis 0.0)
                 (lerp axis 0.0 (- claw-max-rotation-angle))
                 (lerp axis 0.0 claw-max-rotation-angle))
        current (cpp/b2RevoluteJoint_GetAngle (cpp/* joint-id))
        speed (clamp (* claw-carriage-track-gain (- target current))
                     (- claw-carriage-rotation-max-speed)
                     claw-carriage-rotation-max-speed)]
    (cpp/b2RevoluteJoint_SetMotorSpeed (cpp/* joint-id) speed)))

(defn drive-claw-carriage! [^(:* b2BodyId) carriage-id
                            axes]
  (let [pos (cpp/b2Body_GetPosition (cpp/* carriage-id))
        ; Lock the carriage within the playspace, but also prevent it from entering
        ; the bucket area.
        min-x (if (< (.-y pos) (+ (/ world-height -2.0) bucket-wall-height))
                (- (- (/ world-width 2) wall-width bucket-width))
                (- (- (/ world-width 2) (/ wall-width 2))))
        min-y (if (< (.-x pos) (- (- (/ world-width 2) wall-width bucket-width)))
                (+ (/ world-height -2.0) bucket-wall-height)
                (* world-height -0.35))
        axes (cond
               (and (<= (- (/ world-width 2) (/ wall-width 2)) (.-x pos)) (< 0.0 (:x axes)))
               (assoc axes :x 0.0)
               (and (<= (.-x pos) min-x) (< (:x axes) 0.0))
               (assoc axes :x 0.0)
               :else
               axes)
        axes (cond
               (and (<= (- (/ world-height 2) (/ wall-width 2)) (.-y pos))
                    (< 0.0 (:y axes)))
               (assoc axes :y 0.0)
               (and (<= (.-y pos) min-y) (< (:y axes) 0.0))
               (assoc axes :y 0.0)
               :else
               axes)]
    (cpp/b2Body_SetLinearVelocity (cpp/* carriage-id) axes)))

(defn update-claw! [state]
  (let [{:keys [carriage-id
                central-hub-joint-id
                left-joint-id right-joint-id]} (:physics state)
        {:keys [gamepad-index]} state
        left-claw-axis (-> (cpp/GetGamepadAxisMovement gamepad-index
                                                       cpp/GAMEPAD_AXIS_LEFT_TRIGGER)
                           normalize-claw-tip-axis)
        right-claw-axis (-> (cpp/GetGamepadAxisMovement gamepad-index
                                                        cpp/GAMEPAD_AXIS_RIGHT_TRIGGER)
                            normalize-claw-tip-axis)
        rotation-axis (cpp/GetGamepadAxisMovement gamepad-index cpp/GAMEPAD_AXIS_RIGHT_X)
        rotation-axis (if (<= (abs rotation-axis) gamepad/deadzone)
                        0.0
                        rotation-axis)
        pos-x (cpp/GetGamepadAxisMovement gamepad-index cpp/GAMEPAD_AXIS_LEFT_X)
        pos-y (- (cpp/GetGamepadAxisMovement gamepad-index cpp/GAMEPAD_AXIS_LEFT_Y))
        pos-axes (cond-> {:x (* pos-x claw-carriage-max-speed)
                          :y (* pos-y claw-carriage-max-speed)}
                   ; Manage stick drift.
                   (<= (abs pos-x) gamepad/deadzone)
                   (assoc :x 0)
                   (<= (abs pos-y) gamepad/deadzone)
                   (assoc :y 0))]
    ;(println :pos {:x x :y y})
    ;(println :rotation-axis rotation-axis)
    (drive-claw-tip! left-joint-id :left left-claw-axis)
    (drive-claw-tip! right-joint-id :right right-claw-axis)
    (drive-claw-rotation! central-hub-joint-id rotation-axis)
    (drive-claw-carriage! carriage-id pos-axes)))

(defn update-pieces! [state]
  (let [world-id-box (get-in state [:physics :world-id])
        world-id (cpp/* (cpp/unbox (:* b2WorldId) world-id-box))
        events (cpp/b2World_GetSensorEvents world-id)
        pieces-to-remove (transient [])]
    (dotimes [i (.-beginCount events)]
      (let [body-id (cpp/b2Shape_GetBody (.-visitorShapeId (cpp/aget (.-beginEvents events) i)))]
        (when (cpp/b2Body_IsValid body-id)
          (conj! pieces-to-remove (cpp/box (cpp/new b2BodyId body-id))))))
    (if (empty? pieces-to-remove)
      state
      (reduce (fn [state body-id*]
                (let [body-id (cpp/* (cpp/unbox (:* b2BodyId) body-id*))

                      ; Find and remove the piece in the global state tracker.
                      ; Keys are b2BodyId*, need to unbox and compare by value.
                      [piece-key piece] (some (fn [[k v]]
                                                (when (-> (cpp/* (cpp/unbox (:* b2BodyId) k))
                                                          (cpp/b2BodyIdEquals body-id))
                                                  [k v]))
                                              (get-in state [:physics :pieces]))
                      state (update-in state [:physics :pieces] dissoc piece-key)]

                  ; Destroy the physics body for the piece.
                  (when (cpp/b2Body_IsValid body-id)
                    (cpp/b2DestroyBody body-id))

                  ; Handle the collection based on the piece type.
                  (case (:type piece)
                    ; Token score. Start the game.
                    :token
                    (assoc state :mode :countdown
                                 :countdown-time-remaining 3)

                    ; Standard piece type.
                    (let [; Score the piece in the bucket.
                          state (bucket/on-collect state piece)

                          ; Chance to spawn a new piece to keep the bucket populated.
                          ; TODO: consider random chance for new piece to become a bonus piece
                          state (if (<= chance-to-spawn-piece-on-score (rand))
                                  (let [new-piece (spawn-random-piece! (get-in state [:physics :world-id]))]
                                    (assoc-in state [:physics :pieces (:body-id new-piece)] new-piece))
                                  state)]
                      state))))
              state
              (persistent! pieces-to-remove)))))

(defn update! [state]
  (let [world-id (cpp/* (cpp/unbox (:* b2WorldId) (get-in state [:physics :world-id])))
        delta (cpp/GetFrameTime)
        state (do
                (update-claw! state)
                (update-pieces! state))]
    ; TODO: Do this step before or after other updates?
    (cpp/b2World_Step world-id delta sub-step-count)
    state))
