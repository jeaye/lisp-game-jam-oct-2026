(ns com.jeaye.claw-game.bucket)

; TODO: core game loop
; - game modes/menus, transitions (main-menu, playing, paused, game-over)
; - game timer (30s)
; - score (simple, bonus, combo)
; - bonus piece selection
; - game over stats
; - game pause
; - controller support

(def piece-types [:triangle :square])

(comment
  ; Piece spec.
  ; TODO: add piece metadata in the phy object
  {:type [:enum piece-types]}
  )

(defn rand-bonus-piece-type []
  (rand-nth piece-types))

(defn add-score [state piece]
  (let [score 100 ; base piece score
        score-multiplier 1 ; base score multiplier

        ; Bonus piece scoring.
        ; TODO: consider requiring a new bonus shape type on re-select
        {:keys [bonus-piece-type
                bonus-score-multiplier
                bonus-time-remaining]
         :or {bonus-score-multiplier 1
              bonus-time-remaining 0}}
        (when (= (:bonus-piece-type state) (:type piece))
          {:bonus-piece-type (rand-bonus-piece-type) ; new bonus piece type
           :bonus-score-multiplier 5 ; x base multiplier
           :bonus-time-remaining 10}) ; + seconds

        ; TODO: combo scoring
        ; if combo time remaining -> add multiplier, inc combo counter
        ; else -> reset combo counter
        ; add combo time

        score-multiplier (* score-multiplier bonus-score-multiplier)
        score-total (* score score-multiplier)]
    (cond-> state
      true (update :score + score-total)
      ; Bonus piece scoring rewards, if applicable.
      (some? bonus-piece-type) (assoc :bonus-piece-type bonus-piece-type)
      (pos? bonus-time-remaining) (update :time-remaining + bonus-time-remaining))))

; TODO: call this on each piece collected by the bucket
(defn on-collect [state piece]
  (let [state (add-score state piece)]
    ; TODO: add metrics (scored, bonus, max combo, etc.)
    ; TODO: spawn fx
    state))

(comment
  (let [delta (cpp/GetFrameTime)
        state (if (pos? (:time-remaining state))
                (let [state (update state :time-remaining - delta)
                      _ (when (neg? (:time-remaining state)) (println "ded"))]
                     state))]
       state)
  )
