(ns com.jeaye.claw-game.bucket)

; Score configuration.
(def score-base 100) ; base score per piece
(def bonus-score-multiplier 5) ; score multiplier for bonus piece
(def bonus-time-added 10) ; seconds; time added per bonus piece scored
(def combo-time 1) ; seconds; total time to count as an active combo, reset on each piece score
(def combo-score-multiplier-added 0.5) ; combo score multiplier added per piece scored during an active combo

(def piece-types [:triangle :box :circle :rectangle :capsule])

(defn add-score [state piece]
  (let [score score-base ; base piece score

        ; Bonus piece scoring. Bonus points, bonus time.
        ; TODO: consider requiring a new bonus shape type on re-select
        {:keys [bonus-score-multiplier
                bonus-time-remaining]
         :or {bonus-score-multiplier 1
              bonus-time-remaining 0}}
        (when (:bonus? piece)
          {:bonus-score-multiplier bonus-score-multiplier ; x base multiplier
           :bonus-time-remaining bonus-time-added}) ; + seconds

        ; Combo scoring. Extra multiplier applied to every score.
        {:keys [combo-score-multiplier]
         :or {combo-score-multiplier 1}}
        state

        ; Apply combination of bonus and combo multipliers.
        score-multiplier (*  combo-score-multiplier)
        score-total (* score score-multiplier)]
    (cond-> state
      true (update :score + score-total)
      ; Bonus piece scoring rewards, if applicable.
      (pos? bonus-time-remaining) (update :time-remaining + bonus-time-remaining)
      ; Combo scoring. Extra points for pieces scored in quick succession.
      ; Combo rewards are updated post-scoring, applied to the next piece scored.
      true (assoc :combo-time-remaining combo-time) ; reset combo time, not additive
      true (update :combo-score-multiplier + combo-score-multiplier-added) ; increase multiplier with each score
      true (update :combo-count inc))))

(defn on-collect [state piece]
  (let [state (add-score state piece)]
    ; TODO: add end game metrics (scored, bonus, max combo, etc.)
    ; TODO: spawn fx
    state))
