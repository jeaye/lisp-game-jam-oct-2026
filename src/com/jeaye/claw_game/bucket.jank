(ns com.jeaye.claw-game.bucket)

; TODO: core game loop
; - game modes/menus, transitions (main-menu, playing, paused, game-over)
; - game timer (30s)
; - score (simple, bonus, combo)
; - bonus shape selection
; - game over stats
; - game pause
; - controller support

; TODO: store shape definitions in the global map (phy obj + metadata) (piece?)

(def shape-types [:triangle :square])

(defn add-score [state shape]
  (let [score 100 ; base score
        score-multiplier 1 ; base multiplier

        ; TODO: bonus
        ; if compare shape type -> add multiplier, re-roll bonus shape, add time
        ; else -> nop

        {:key [state score-multiplier]}
        (if (= (:bonus-shape-type state) (:type shape))
          ; Scored a shape matching the bonus shape.
          {; Bump the score multiplier for the bonus shape.
           :score-multiplier (* score-multiplier 2)
           :state (-> state
                    ; Re-select a new bonus shape type.
                    ; TODO: consider requiring a new bonus shape type
                    (assoc :bonus-shape-type (rand-nth shape-types))
                    ; Add remaining game time (seconds).
                    (update :time-remaining + 3))}
          ; Non-bonus shape scored; nop.
          {:score-multiplier score-multiplier
           :state state})

        ; TODO: combo
        ; if combo time remaining -> add multiplier, inc combo counter
        ; else -> reset combo counter
        ; add combo time

        score-total (* score score-multipler)
        state (update state :score + score-total)]
    state))

(defn on-collide [state shape]
  (let [state (add-score state shape)]
    ; TODO: destroy shape (def, physics object)
    ; TODO: add score (simple, bonus (+ re-select + time), combo)
    ; TODO: add metrics (scored, bonus, max combo, etc.)
    ; TODO: spawn fx
    state))

(comment
  (let [delta (cpp/GetFrameTime)
        state (if (pos? (:time-remaining state))
                (let [state (update state :time-remaining - delta)
                      _ (when (neg? (:time-remaining state)) (println "ded"))]
                     state))]
       state))