(ns com.jeaye.claw-game
  (:include "raylib.h"
            "box2d/box2d.h"
            "box2d_draw.h")
  (:require [com.jeaye.claw-game.physics :as physics]))

(def global-state (atom nil))

(defn start-game! []
  (physics/destroy-world! (get-in @global-state [:physics :world-id]))
  {:physics {:world-id (physics/create-world!)}})

(comment
  (reset! global-state (start-game!))
  (deref global-state))

(defn update-game [state]
  (try
    (if (= :playing (:mode state))
      state
      state)
    (catch jank.runtime.object_ref e
      (prn e)
      state)
    (catch jank.error_ref e
      (prn (.-message (cpp/* e)))
      state)
    (catch std.exception e
      (prn (.what e))
      state)
    (catch :default _
      (println "update exception")
      state)))

(defn render-game! [state]
  (try
    (cpp/BeginDrawing)
    (cpp/ClearBackground cpp/BLACK)

    (let [debug (cpp/b2CreateDebugDraw (float (/ (cpp/GetScreenWidth) physics/world-width)))]
      (cpp/b2World_Draw (cpp/* (cpp/unbox (:* b2WorldId) (get-in state [:physics :world-id])))
                        (cpp/& debug)))

    (cpp/EndDrawing)
    (catch jank.runtime.object_ref e
      (prn e))
    (catch jank.error_ref e
      (prn (.-message (cpp/* e))))
    (catch std.exception e
      (prn (.what e)))
    (catch :default _
      (println "render exception"))))

(defn -main [& args]
  (cpp/InitWindow 720 1080 "janky claw")
  (cpp/SetTargetFPS 60)

  (reset! global-state (start-game!))
  (while (cpp/! (cpp/WindowShouldClose))
    (swap! global-state
           (fn [state]
             (let [state (update-game state)]
               (render-game! state)
               state))))

  (cpp/CloseWindow))

(comment
  (def fut (future (-main))))
