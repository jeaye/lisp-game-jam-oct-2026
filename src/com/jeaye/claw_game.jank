(ns com.jeaye.claw-game
  (:include "raylib.h"
            "box2d/box2d.h"
            "box2d_draw.h"
            "box2d-trait.hpp")
  (:require [clojure.string]
            [com.jeaye.claw-game.physics :as physics]
            [com.jeaye.claw-game.bucket :as bucket]
            [com.jeaye.claw-game.gamepad :as gamepad]))

(defonce global-state (atom nil))
(defonce last-error (atom nil))

(def base-font-size 20)
(def title-font-size (* base-font-size 2))
(def header-font-size (int (* base-font-size 1.5)))
(def body-font-size base-font-size)

; Rather than spitting out the same error thousands of times, we dedupe
; so that repeated errors are logged once.
(defn log-error! [e]
  (when-not (= e @last-error)
    (println e)
    (reset! last-error e)))

; TODO: remove bang
(defn start-game! []
  {:mode :gamepad-selection ; :gamepad-selection, :playing, :game-over
   :gamepad-index 0

   :score 0
   :time-remaining 60 ; seconds
   :combo-time-remaining 0 ; seconds
   :combo-score-multiplier 1
   :combo-count 0

   ; :physics {:world-id ^(:* b2WorldId) _
   ;           :pieces {b2BodyId... {:type [:enum bucket/piece-types]
   ;                                 :bonus? :boolean}}}

   ; Box2D can't be changed from another thread, so if we want to re-create the world, we
   ; need to do it on the main thread. Since each REPL command runs off the main thread,
   ; we need a way to enqueue work for the main thread. We do that with this queue.
   ;
   ; We also use this to enqueue the destruction of box2d pieces, since they can't be
   ; destroyed during the update loop.
   :queue []})

(defn start-playing! [state]
  (physics/destroy-world! (get-in state [:physics :world-id]))
  (assoc state
         :mode :playing
         :physics (physics/create-world!)))

; This will restart the game in a thread-safe fashion.
(defn restart-game! []
  (swap! global-state (fn [state]
                        (update state :queue conj (fn [state]
                                                    (start-game!))))))

(comment
  (restart-game!)
  (deref global-state))

(defn update-time-remaining [state]
  (let [time-remaining (-> (:time-remaining state)
                           (- (cpp/GetFrameTime))
                           (max 0))]
    (cond-> state
      true (assoc :time-remaining time-remaining)
      ; Game time complete. Game over.
      ; TODO: stop physics or disable collection on game over
      (zero? time-remaining) (assoc :mode :game-over))))

(defn update-combo-time-remaining [state]
  (let [time-remaining (-> (:combo-time-remaining state)
                           (- (cpp/GetFrameTime))
                           (max 0))]
    (cond-> state
      true (assoc :combo-time-remaining time-remaining)
      ; Combo time complete. Reset the combo accumulators.
      (zero? time-remaining) (assoc :combo-score-multiplier 1
                                    :combo-count 0))))

(defn update-game [state]
  (try
    (case (:mode state)
      :gamepad-selection
      (let [id (gamepad/find-gamepad-index)]
        (if (<= 0 id)
          (assoc (start-playing! state)
                 :gamepad-index id)
          state))

      :playing
      (do
        ; debug hotkeys
        (when (cpp/IsKeyPressed cpp/KEY_ENTER)
          (restart-game!))

        (-> state
            physics/update!
            ; TODO: restore update time
            ; update-time-remaining
            update-combo-time-remaining))

      :game-over
      (do
        ; Restart the game on accept button pressed.
        (when (gamepad/is-accept-button-pressed (:gamepad-index state))
          ; TODO: This requires pressing X twice. Let's jump right into :playing instead.
          (restart-game!))

        state)

      ; :else
      state)
    (catch jank.runtime.object_ref e
      (log-error! (str "update exception: " (prn e)))
      state)
    (catch jank.error_ref e
      (log-error! (str "update exception: " (.-message (cpp/* e))))
      state)
    (catch std.exception e
      (log-error! (str "update exception:" (.what e)))
      state)
    (catch :default _
      (log-error! "update exception")
      state)))

(defn draw-centered-text! [msg font-size y-offset]
  (let [width (cpp/GetScreenWidth)
        height (cpp/GetScreenHeight)
        length (cpp/MeasureText msg font-size)]
    (cpp/DrawText msg
                  (- (/ width 2) (/ length 2))
                  (+ (/ height 2) y-offset)
                  font-size
                  (cpp/GetColor 0xff6ec7ff))))

(defn draw-world! [state]
  (let [debug (cpp/b2CreateDebugDraw (/ (cpp/GetScreenWidth) (* physics/world-width 1.05)))
        world-id (cpp/* (cpp/unbox (:* b2WorldId) (get-in state [:physics :world-id])))]
    (cpp/b2World_Draw world-id (cpp/& debug))))

(defn draw-ui! [state]
  (when (= :game-over (:mode state))
    ; TODO: add complete game over stats
    ; TODO: add better formatting and styling
    (cpp/DrawRectangle 145 200 430 140 cpp/MAGENTA)
    (cpp/DrawRectangle 150 205 420 130 cpp/BLACK)
    (cpp/DrawText "GAME OVER" 160 215 header-font-size cpp/MAGENTA)
    (cpp/DrawText (format "SCORE: {}" (:score state)) 160 250 body-font-size cpp/MAGENTA)
    (cpp/DrawText (format "PRESS THE {} BUTTON TO RESTART" (gamepad/get-accept-button-name))
                  160 305 body-font-size cpp/MAGENTA))

  ; debug
  (cpp/DrawText (clojure.string/replace
                  (select-keys state [:score
                                      :time-remaining
                                      :combo-time-remaining
                                      :combo-score-multiplier
                                      :combo-count
                                      :mode])
                  #"," ",\n")
                150 10 body-font-size cpp/MAGENTA))

(defn render-game! [state]
  (try
    (cpp/BeginDrawing)
    (cpp/ClearBackground cpp/BLACK)

    (case (:mode state)
      :gamepad-selection
      (do
        (let [msg (format "PRESS THE {} BUTTON" (gamepad/get-accept-button-name))]
          (draw-centered-text! msg title-font-size 0)
          (draw-centered-text! "ON YOUR CONTROLLER" title-font-size title-font-size)
          (draw-centered-text! "TO BEGIN" title-font-size (* 2 title-font-size))))

      (:playing :game-over)
      (do
        (draw-world! state)
        (draw-ui! state))

      ; :else
      nil)

    (cpp/EndDrawing)
    (catch jank.runtime.object_ref e
      (log-error! (str "render exception: " (prn e))))
    (catch jank.error_ref e
      (log-error! (str "render exception: " (.-message (cpp/* e)))))
    (catch std.exception e
      (log-error! (str "render exception:" (.what e))))
    (catch :default _
      (log-error! "render exception"))))

(defn -main [& args]
  (cpp/InitWindow 720 1080 "janky claw")
  #_(cpp/InitWindow 460 720 "janky claw")
  (cpp/SetTargetFPS 60)
  ; TODO: restore?
  ; (cpp/HideCursor)

  (reset! global-state (start-game!))
  (while (cpp/! (cpp/WindowShouldClose))
    (swap! global-state
           (fn [state]
             (let [state (update-game state)]
               (render-game! state)
               (if (empty? (:queue state))
                 state
                 (reduce (fn [state f]
                           (try
                             (f state)
                             (catch jank.runtime.object_ref e
                               (log-error! (str "queue exception: " (prn e)))
                               state)
                             (catch jank.error_ref e
                               (log-error! (str "queue exception: " (.-message (cpp/* e))))
                               state)
                             (catch std.exception e
                               (log-error! (str "queue exception:" (.what e)))
                               state)
                             (catch :default _
                               (log-error! "queue exception")
                               state)))
                         (assoc state :queue [])
                         (:queue state)))))))

  (cpp/CloseWindow))

(comment
  (def fut (future (-main))))
