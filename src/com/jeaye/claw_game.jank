(ns com.jeaye.claw-game
  (:include "raylib.h"
            "rlgl.h"
            "raylib-trait.hpp"
            "box2d/box2d.h"
            "box2d_draw.h"
            "box2d-trait.hpp")
  (:require [clojure.string]
            [com.jeaye.claw-game.physics :as physics]
            [com.jeaye.claw-game.bucket :as bucket]
            [com.jeaye.claw-game.gamepad :as gamepad]
            [com.jeaye.claw-game.graphics :as graphics]))

(defonce global-state (atom nil))
(defonce last-error (atom nil))

; Rather than spitting out the same error thousands of times, we dedupe
; so that repeated errors are logged once.
(defn log-error! [e]
  (when-not (= e @last-error)
    (println e)
    (reset! last-error e)))

(defn reset-state! [state]
  (physics/destroy-world! (get-in state [:physics :world-id]))
  {:mode :coin-drop ; :coin-drop, :countdown, :playing, :paused, :game-over

   ; Active gamepad index. When invalid, update loop searches each gamepad,
   ; accepting the first gamepad with any input as the active gamepad index.
   :gamepad-index -1

   ; Countdown time remaining when transitioning between coin drop and playing.
   :countdown-time-remaining 3 ; seconds

   ; Time remaining during :playing mode.
   :time-remaining 30 ; seconds

   ; Total accumulated score during :playing mode.
   :score 0

   ; Combo scoring state tracker.
   :combo-time-remaining 0 ; seconds
   :combo-score-multiplier 1
   :combo-count 0

   ; Stats tracking for the game over screen.
   :stats {:pieces-scored []
           :max-combo-count 0
           :start-time 0
           :end-time 0}

   ; :physics {:world-id ^(:* b2WorldId) _
   ;           :pieces {b2BodyId*... {:type [:enum bucket/piece-types]
   ;                                  :bonus? :boolean}}}
   :physics (physics/create-world! :coin-drop)

   ; Box2D can't be changed from another thread, so if we want to re-create the world, we
   ; need to do it on the main thread. Since each REPL command runs off the main thread,
   ; we need a way to enqueue work for the main thread. We do that with this queue.
   ;
   ; We also use this to enqueue the destruction of box2d pieces, since they can't be
   ; destroyed during the update loop.
   :queue []})

; This will restart the game in a thread-safe fashion.
(defn restart-game! []
  (swap! global-state (fn [state]
                        (update state :queue conj reset-state!))))

(defn update-timer [timer]
  (max (- timer (cpp/GetFrameTime))
       0))

(defn update-time-remaining [state]
  (let [state (update state :time-remaining update-timer)]
    (if (zero? (:time-remaining state))
      ; Game time complete. Game over.
      (-> state
          (assoc-in [:stats :end-time] (cpp/GetTime))
          (assoc :mode :game-over))
      state)))

(defn update-combo-time-remaining [state]
  (let [state (update state :combo-time-remaining update-timer)]
    (if (zero? (:combo-time-remaining state))
      ; Combo time complete. Reset the combo accumulators.
      (assoc state :combo-score-multiplier 1
                   :combo-count 0)
      state)))

(defn update-countdown-time-remaining [state]
  (let [state (update state :countdown-time-remaining update-timer)]
    (if (zero? (:countdown-time-remaining state))
      ; Countdown timer complete. Start the game.
      (do
        (physics/destroy-world! (get-in state [:physics :world-id]))
        (-> state
            (assoc-in [:stats :start-time] (cpp/GetTime))
            (assoc :physics (physics/create-world! :playing)
                   :mode :playing)))
      state)))

(defn update-paused [state]
  (if (gamepad/is-pause-button-pressed (:gamepad-index state))
    (case (:mode state)
      :playing (assoc state :mode :paused)
      :paused (assoc state :mode :playing)
      state)
    state))

(defn update-game [state]
  (try
    ; debug hotkeys
    (when (cpp/IsKeyPressed cpp/KEY_ENTER)
      (restart-game!))

    ; Restart the game on gamepad accept button.
    (when (gamepad/is-accept-button-pressed (:gamepad-index state))
      (when (= :game-over (:mode state))
        (restart-game!)))

    (cond-> state
      true gamepad/update-gamepad-index
      (not (graphics/paused? state)) physics/update!
      (= :playing (:mode state)) update-time-remaining
      (= :playing (:mode state)) update-combo-time-remaining
      (= :countdown (:mode state)) update-countdown-time-remaining
      true update-paused)

    (catch jank.runtime.object_ref e
      (log-error! (str "update exception: " (prn e)))
      state)
    (catch jank.error_ref e
      (log-error! (str "update exception: " (.-message (cpp/* e))))
      state)
    (catch std.exception e
      (log-error! (str "update exception:" (.what e)))
      state)
    (catch :default _
      (log-error! "update exception")
      state)))

(defn render-game! [state]
  (try
    (cpp/BeginDrawing)
    (cpp/ClearBackground graphics/background-color)

    (graphics/render! state)

    (cpp/EndDrawing)
    (catch jank.runtime.object_ref e
      (log-error! (str "render exception: " (prn e))))
    (catch jank.error_ref e
      (log-error! (str "render exception: " (.-message (cpp/* e)))))
    (catch std.exception e
      (log-error! (str "render exception:" (.what e))))
    (catch :default _
      (log-error! "render exception"))))

(defn -main [& args]
  (cpp/SetConfigFlags (cpp/| cpp/FLAG_MSAA_4X_HINT cpp/FLAG_VSYNC_HINT))
  #_(cpp/InitWindow 1920 1080 "janky claw") ; 16:9
  (cpp/InitWindow 960 540 "shape.wav")
  (cpp/SetTargetFPS 60)
  (cpp/rlEnableSmoothLines)

  (cpp/InitAudioDevice)

  ; This is stored separately from the game state, since we end up resetting
  ; that all the time and we want to keep the music consistent.
  (let [music (cpp/LoadMusicStream "resources/arcade-of-shadows.ogg")]
    (cpp/SetMusicVolume music 0.1)
    (cpp/PlayMusicStream music)

    (swap! global-state reset-state!)
    (while (cpp/! (cpp/WindowShouldClose))
      (swap! global-state
             (fn [state]
               (cpp/UpdateMusicStream music)

               (let [state (update-game state)]
                 (render-game! state)
                 (if (empty? (:queue state))
                   state
                   (reduce (fn [state f]
                             (try
                               (f state)
                               (catch jank.runtime.object_ref e
                                 (log-error! (str "queue exception: " (prn e)))
                                 state)
                               (catch jank.error_ref e
                                 (log-error! (str "queue exception: " (.-message (cpp/* e))))
                                 state)
                               (catch std.exception e
                                 (log-error! (str "queue exception:" (.what e)))
                                 state)
                               (catch :default _
                                 (log-error! "queue exception")
                                 state)))
                           (assoc state :queue [])
                           (:queue state)))))))

    (cpp/UnloadMusicStream music))

  (cpp/CloseAudioDevice)
  (cpp/CloseWindow))

(comment
  (def fut (future (-main)))
  (restart-game!)
  (deref global-state))
