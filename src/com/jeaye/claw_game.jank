(ns com.jeaye.claw-game
  (:include "raylib.h"
            "box2d/box2d.h"
            "box2d_draw.h")
  (:require [com.jeaye.claw-game.physics :as physics]))

(def global-state (atom nil))

(defn start-game! []
  (physics/destroy-world! (get-in @global-state [:physics :world-id]))
  {:mode :playing
   :physics (physics/create-world!)
   ; Box2D can't be changed from another thread, so if we want to re-create the world, we
   ; need to do it on the main thread. Since each REPL command runs off the main thread,
   ; we need a way to enqueue work for the main thread. We do that with this queue.
   :queue []})

(comment
  ; This will restart the game in a thread-safe fashion.
  (swap! global-state (fn [state]
                        (update state :queue conj (fn [state]
                                                    (start-game!)))))
  (deref global-state))

(defn update-game [state]
  (try
    (if (= :playing (:mode state))
      (let [world-id (cpp/* (cpp/unbox (:* b2WorldId) (get-in state [:physics :world-id])))
            delta (cpp/GetFrameTime)]
        (cpp/b2World_Step world-id delta physics/sub-step-count)
        state)
      state)
    (catch jank.runtime.object_ref e
      (prn e)
      state)
    (catch jank.error_ref e
      (prn (.-message (cpp/* e)))
      state)
    (catch std.exception e
      (prn (.what e))
      state)
    (catch :default _
      (println "update exception")
      state)))

(defn render-game! [state]
  (try
    (cpp/BeginDrawing)
    (cpp/ClearBackground cpp/BLACK)

    (let [debug (cpp/b2CreateDebugDraw (/ (cpp/GetScreenWidth) (* physics/world-width 1.5)))
          world-id (cpp/* (cpp/unbox (:* b2WorldId) (get-in state [:physics :world-id])))]
      (cpp/b2World_Draw world-id (cpp/& debug)))

    (cpp/EndDrawing)
    (catch jank.runtime.object_ref e
      (prn e))
    (catch jank.error_ref e
      (prn (.-message (cpp/* e))))
    (catch std.exception e
      (prn (.what e)))
    (catch :default _
      (println "render exception"))))

(defn -main [& args]
  (cpp/InitWindow 720 1080 "janky claw")
  (cpp/SetTargetFPS 60)

  (reset! global-state (start-game!))
  (while (cpp/! (cpp/WindowShouldClose))
    (swap! global-state
           (fn [state]
             (let [state (update-game state)]
               (render-game! state)
               (if (empty? (:queue state))
                 state
                 (reduce (fn [state f]
                           (f state))
                         (assoc state :queue [])
                         (:queue state)))))))

  (cpp/CloseWindow))

(comment
  (def fut (future (-main))))
